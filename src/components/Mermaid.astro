---
interface Props { theme?: 'default' | 'dark' | 'neutral' | 'base'; vars?: Record<string, string> }
const { theme = 'neutral', vars = {} } = Astro.props;
---
<div hidden data-mermaid-cfg data-theme={theme} data-vars={JSON.stringify(vars)}></div>
<script>
  const blocks = document.querySelectorAll('pre.mermaid');
  if (blocks.length) {
    const cfg = document.querySelector<HTMLElement>('[data-mermaid-cfg]')!;
    import('mermaid').then(({ default: mermaid }) => {
      mermaid.initialize({ startOnLoad: false, theme: cfg.dataset.theme as any, themeVariables: JSON.parse(cfg.dataset.vars || '{}'), securityLevel: 'strict', fontFamily: 'inherit' });
      mermaid.run({ nodes: blocks as any });
    });
  }
</script>
