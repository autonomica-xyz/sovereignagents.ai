---
import { catLabel, fmtDate } from '../lib/wiki';
interface Props { items: any[]; base: string; showCat?: boolean; cats?: { id: string; plural: string; count: number }[] }
const { items, base, showCat = true, cats } = Astro.props;
---
{cats && <div class="filters" data-catf><div class="grp" style="flex-wrap:wrap"><button class="on" data-v="all">All {items.length}</button>{cats.map((c) => <button data-v={c.id}>{c.plural} <span style="opacity:.5">{c.count}</span></button>)}</div></div>}
<div class="table-wrap" style="margin:0">
<table class="tbl" data-sortable>
  <thead><tr><th data-k="t">Entry</th>{showCat && <th data-k="c">Class</th>}<th class="hide-m" data-k="u">Observed</th><th class="num" data-k="b">Cited by</th><th class="num hide-m" data-k="s">Sources</th></tr></thead>
  <tbody>
    {items.map((a) => (
      <tr data-c={a.category} data-t={a.title.toLowerCase()} data-u={a.updated || '0'} data-b={a.backlinks.length} data-s={a.sourceCount}>
        <td><a href={`${base}/wiki/${a.slug}`}>{a.title}</a><span class="sum">{a.summary}</span></td>
        {showCat && <td><span class={`cls ${a.category}`}>{catLabel(a.category)}</span></td>}
        <td class="num hide-m" style="text-align:left">{a.updated ? fmtDate(a.updated, 'short') : '—'}</td>
        <td class="num">{a.backlinks.length}</td>
        <td class="num hide-m">{a.sourceCount}</td>
      </tr>
    ))}
  </tbody>
</table>
</div>
<script>
  for (const tbl of document.querySelectorAll<HTMLTableElement>('[data-sortable]')) {
    const body = tbl.tBodies[0]; let dir = 1, key = '';
    tbl.querySelectorAll<HTMLElement>('th[data-k]').forEach((th) => th.addEventListener('click', () => {
      const k = th.dataset.k!; dir = key === k ? -dir : (k === 't' || k === 'c' ? 1 : -1); key = k;
      const rows = [...body.rows].sort((a, b) => { const x = a.dataset[k]!, y = b.dataset[k]!; const nx = Number(x), ny = Number(y); return (isNaN(nx) || k === 'u' ? x.localeCompare(y) : nx - ny) * dir; });
      body.append(...rows);
    }));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-catf] button').forEach((b) => b.addEventListener('click', () => {
    b.parentElement!.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    document.querySelectorAll<HTMLElement>('[data-sortable] tbody tr').forEach((r) => { r.style.display = b.dataset.v === 'all' || r.dataset.c === b.dataset.v ? '' : 'none'; });
  }));
</script>
