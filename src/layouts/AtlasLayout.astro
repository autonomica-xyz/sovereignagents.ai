---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import '../styles/atlas.css';
import Search from '../components/Search.astro';
import Mermaid from '../components/Mermaid.astro';
import { wiki, fmtDate } from '../lib/wiki';
interface Props { title?: string; description?: string; active?: string; flush?: boolean }
const { title, description = 'An interactive atlas of sovereign agents: the knowledge graph and anatomy of digital organisms.', active = '', flush = false } = Astro.props;
const B = '/proposal-b';
const { meta } = wiki();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title ? `${title} · Sovereign Agents Atlas` : 'Sovereign Agents Atlas'}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#05070d" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%2305070d'/><circle cx='16' cy='16' r='5' fill='%234fd2ff'/><circle cx='16' cy='16' r='10' fill='none' stroke='%23ff5d73' stroke-width='1.5'/></svg>" />
</head>
<body class="atlas">
  <header class="topbar">
    <a class="brand" href={B}><span class="brand-mark"><i></i></span><span>Sovereign Agents <b>Atlas</b></span></a>
    <nav>
      <a href={`${B}`} class={active === 'map' ? 'on' : ''}>Map</a>
      <a href={`${B}/anatomy`} class={active === 'anatomy' ? 'on' : ''}>Anatomy</a>
      <a href={`${B}/feed`} class={active === 'feed' ? 'on' : ''}>Signals</a>
      <a href={`${B}/browse`} class={active === 'browse' ? 'on' : ''}>Regions</a>
    </nav>
    <button class="search-btn" data-open-search><svg viewBox="0 0 24 24" width="15" height="15"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2"/></svg><span>Search</span><kbd>⌘K</kbd></button>
    <a class="proto" href="/">B · all proposals</a>
  </header>
  <main class:list={{ flush }}><slot /></main>
  {!flush && <footer class="afoot"><span>Atlas built from <a href={meta.repo}>sovereign-agents-research</a> @ {meta.head} · synced {fmtDate(meta.syncedAt)}</span><a href="/">Compare proposals →</a></footer>}
  <Search base={B} placeholder="Jump to any node…" />
  <Mermaid theme="dark" vars={{ background: '#0b1020', primaryColor: '#121a33', primaryBorderColor: '#4fd2ff', primaryTextColor: '#e6ecff', lineColor: '#ff5d73', fontFamily: 'Space Grotesk Variable, sans-serif' }} />
</body>
</html>
