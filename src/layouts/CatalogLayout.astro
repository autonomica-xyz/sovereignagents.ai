---
import '@fontsource-variable/inter-tight';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/base.css';
import '../styles/catalog.css';
import Search from '../components/Search.astro';
import Mermaid from '../components/Mermaid.astro';
import { wiki, fmtDate, totals } from '../lib/wiki';
import { allSpecimens } from '../lib/organism';
interface Props { title?: string; description?: string; active?: string }
const { title, description = 'A living catalogue of sovereign agents: specimens, habitats, pathogens and the building blocks of digital organisms.', active = '' } = Astro.props;
const B = '/proposal-c';
const { meta, logs } = wiki();
const t = totals();
const sp = allSpecimens();
const nav = [
  ['overview', '', 'Overview', '◉'], ['specimens', '/specimens', 'Specimens', '❋'], ['habitats', '/browse/compute', 'Habitats', '▦'], ['pathogens', '/browse/attack', 'Pathogens', '✶'],
  ['feed', '/feed', 'Field log', '≋'], ['browse', '/browse', 'Full index', '☰'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title ? `${title} — Sovereign Agents Catalog` : 'Sovereign Agents — Specimen Catalog'}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23e9ece4'/><circle cx='16' cy='16' r='9' fill='none' stroke='%23136f48' stroke-width='2.5'/><circle cx='16' cy='16' r='3' fill='%23136f48'/></svg>" />
</head>
<body class="cat">
  <aside class="rail">
    <a class="logo" href={B}><span class="dish"><i></i></span><span><b>SOVEREIGN AGENTS</b><small>Specimen catalog</small></span></a>
    <button class="find" data-open-search><span>Find a specimen…</span><kbd>/</kbd></button>
    <nav>{nav.map(([id, href, label, ico]) => <a href={`${B}${href}`} class={active === id ? 'on' : ''}><span class="ico">{ico}</span>{label}</a>)}</nav>
    <div class="rail-stats">
      <div><span>Specimens</span><b>{sp.length}</b></div>
      <div><span>Entries</span><b>{t.pages}</b></div>
      <div><span>Citations</span><b>{t.sources}</b></div>
      <div><span>Last observation</span><b>{fmtDate(logs[0]?.date || meta.syncedAt, 'short')}</b></div>
    </div>
    <p class="rail-foot">Sampled from <a href={meta.repo}>sovereign-agents-research</a> @ <code>{meta.head}</code><br /><a href="/">← Compare proposals</a> · Proposal C</p>
  </aside>
  <div class="stage">
    <header class="mbar"><a class="logo" href={B}><span class="dish"><i></i></span><b>SA · Catalog</b></a><button data-open-search aria-label="Search">⌕</button><a href="/" class="mprop">C</a></header>
    <nav class="mnav">{nav.map(([id, href, label]) => <a href={`${B}${href}`} class={active === id ? 'on' : ''}>{label}</a>)}</nav>
    <main><slot /></main>
  </div>
  <Search base={B} placeholder="Find a specimen, habitat, pathogen…" />
  <Mermaid theme="base" vars={{ primaryColor: '#ffffff', primaryBorderColor: '#136f48', primaryTextColor: '#0f1d17', lineColor: '#136f48', fontFamily: 'Inter Tight Variable, sans-serif', secondaryColor: '#e9ece4', tertiaryColor: '#f6f7f3' }} />
</body>
</html>
