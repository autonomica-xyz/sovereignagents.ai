---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/base.css';
import '../styles/journal.css';
import Search from '../components/Search.astro';
import Mermaid from '../components/Mermaid.astro';
import { wiki, fmtDate, totals } from '../lib/wiki';
interface Props { title?: string; description?: string; active?: string; home?: boolean }
const { home = false, title, description = 'A field journal of sovereign agents: digital organisms that no one can read, stop, steer or seize.', active = '' } = Astro.props;
const B = '/proposal-a';
const { logs, meta } = wiki();
const t = totals();
const latest = logs[0]?.date || meta.syncedAt.slice(0, 10);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title ? `${title} — The Sovereign Agents Field Journal` : 'The Sovereign Agents Field Journal'}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23f3ede2'/><text x='16' y='24' font-size='22' text-anchor='middle' font-family='serif' fill='%23b4361c'>§</text></svg>" />
</head>
<body class="journal">
  <div class="proto-bar"><a href="/">← All proposals</a><span>Proposal A · Field Journal</span></div>
  <header class:list={["mast", { compact: !home }]}>
    <div class="mast-top">
      <span>Vol. I · No. {logs.length}</span>
      <span class="hide-sm">{fmtDate(latest)}</span>
      <span>{t.pages} entries · {t.sources} citations</span>
    </div>
    <a class="mast-title" href={B}>The Sovereign Agents <em>Field Journal</em></a>
    <p class="mast-dek">Dispatches on digital organisms: agents that no one can read, stop, steer or seize.</p>
    <nav class="mast-nav">
      <a href={`${B}/feed`} class={active === 'feed' ? 'on' : ''}>Dispatches</a>
      <a href={`${B}/browse`} class={active === 'browse' ? 'on' : ''}>Departments</a>
      <a href={`${B}/wiki/sovereignty-levels`}>The Ladder</a>
      <a href={`${B}/browse/organism`}>Organisms</a>
      <a href={`${B}/browse/attack`}>Kill vectors</a>
      <a href={`${B}/browse/longform`}>Long reads</a>
      <button data-open-search class="mast-search" aria-label="Search">Search <kbd>/</kbd></button>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="foot">
    <div class="foot-in">
      <p class="foot-title">The Sovereign Agents Field Journal</p>
      <p>Built from the open <a href={meta.repo || 'https://github.com/autonomica-xyz/sovereign-agents-research'}>sovereign-agents-research</a> wiki at <code>{meta.head}</code>, synced {fmtDate(meta.syncedAt)}. Text CC-BY-4.0.</p>
      <p><a href="/">Compare proposals</a> · <a href={`${B}/wiki/index`}>Index</a> · <a href={`${B}/wiki/glossary`}>Glossary</a> · <a href={`${B}/wiki/open-questions`}>Open questions</a></p>
    </div>
  </footer>
  <Search base={B} placeholder="Search the journal…" />
  <Mermaid theme="base" vars={{ primaryColor: '#f3ede2', primaryBorderColor: '#1c1a17', primaryTextColor: '#1c1a17', lineColor: '#b4361c', fontFamily: 'Source Serif 4 Variable, serif', secondaryColor: '#e8dfcf', tertiaryColor: '#fbf8f2' }} />
</body>
</html>
