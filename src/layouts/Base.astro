---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/base.css';
import '../styles/site.css';
import Search from '../components/Search.astro';
interface Crumb { href?: string; label: string }
interface Props { title: string; description?: string; section?: 'blueprint' | 'ecosystem' | 'technology' | 'about' | 'home'; crumbs?: Crumb[] }
const { title, description = 'A reference on how autonomous AI agents survive without an owner: the blueprint, the ecosystem and the technology.', section, crumbs = [] } = Astro.props;
const full = title === 'Sovereign Agents' ? title : `${title} · Sovereign Agents`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { id: 'blueprint', href: '/blueprint/', label: 'Blueprint' },
  { id: 'ecosystem', href: '/ecosystem/', label: 'Ecosystem' },
  { id: 'technology', href: '/technology/', label: 'Technology' },
  { id: 'about', href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#fbfaf7" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%231d3557'/%3E%3Cpath d='M9 22c3 2 11 2 14-2s-3-6-7-7-8-4-5-7 9-2 11 0' fill='none' stroke='%23fbfaf7' stroke-width='2.6' stroke-linecap='round'/%3E%3C/svg%3E" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="mast">
    <div class="wrap mast-in">
      <a class="brand" href="/" aria-label="Sovereign Agents, home"><span class="brand-mark" aria-hidden="true"></span><span>Sovereign Agents</span></a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <button class="search-btn" type="button" data-open-search aria-label="Search (press /)"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span>Search</span><kbd>/</kbd></button>
    </div>
  </header>
  {crumbs.length > 0 && (
    <nav class="wrap crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol></nav>
  )}
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap foot-in">
      <div>
        <p class="foot-brand">Sovereign Agents</p>
        <p class="muted">A reference on software that keeps itself alive. Every claim is sourced and dated; see the <a href="/ecosystem/methodology/">methodology</a>.</p>
      </div>
      <ul class="foot-links">
        <li><a href="/blueprint/">Blueprint</a></li>
        <li><a href="/ecosystem/">Ecosystem</a></li>
        <li><a href="/technology/">Technology</a></li>
        <li><a href="/ecosystem/developments/">Developments</a></li>
      </ul>
      <ul class="foot-links">
        <li><a href="/about/">About</a></li>
        <li><a href="/ecosystem/methodology/">Methodology</a></li>
        <li><a href="https://github.com/autonomica-xyz/sovereignagents.ai">Source</a></li>
        <li><a href="https://github.com/autonomica-xyz/sovereign-agents-research">Research notebook</a></li>
      </ul>
    </div>
  </footer>
  <Search />
</body>
</html>
