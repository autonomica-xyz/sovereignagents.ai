---
import Layout from '../../layouts/AtlasLayout.astro';
import Anatomy from '../../components/Anatomy.astro';
import { wiki, totals, categories, recentChanges, fmtDate, byCategory } from '../../lib/wiki';
import { ATLAS_COLORS } from '../../lib/colors';
const B = '/proposal-b';
const t = totals();
const cats = categories();
const { bySlug } = wiki();
const changes = recentChanges(6);
---
<Layout active="map" flush>
  <section class="map" data-map>
    <canvas aria-label="Knowledge graph of the wiki"></canvas>
    <div class="map-intro">
      <span class="eyebrow">Live knowledge graph</span>
      <h1>The atlas of <span>digital organisms</span></h1>
      <p>Every dot is an entry in the research wiki; every line a citation. Drag to pan, scroll to zoom, click a node to open it.</p>
      <div class="stats"><div><b>{t.pages}</b><span>entries</span></div><div><b>{t.links.toLocaleString('en')}</b><span>links</span></div><div><b>{t.sources}</b><span>sources</span></div></div>
    </div>
    <div class="legend">{cats.filter((c) => c.id !== 'longform').map((c) => <button class="chip" data-cat={c.id} style={`--c:${ATLAS_COLORS[c.id]}`}><i></i>{c.plural} <span style="opacity:.5">{c.count}</span></button>)}</div>
    <div class="zoom"><button data-z="in" aria-label="Zoom in">+</button><button data-z="out" aria-label="Zoom out">−</button><button data-z="reset" aria-label="Reset" style="font-size:13px">⟲</button></div>
    <span class="hint">scroll ↕ zoom · drag ✥ pan</span>
    <div class="card-float"><span class="chip" data-f="cat"><i></i><b></b></span><h3 data-f="t"></h3><p data-f="s"></p><div class="row"><span class="chip" data-f="d"></span><a class="btn" data-f="go" href="#">Open entry →</a></div></div>
    <div class="tip"></div>
  </section>
  <main>
    <section class="sect">
      <div class="sect-head"><div><span class="eyebrow">Anatomy</span><h2>What an organism needs to stay alive</h2></div><p>Building blocks mapped to organs. Pick an organ to see every technology, rail, habitat and threat filed under it.</p></div>
      <Anatomy base={B} />
    </section>
    <section class="sect">
      <div class="sect-head"><div><span class="eyebrow">Signals</span><h2>Latest movements in the graph</h2></div><a class="btn ghost" href={`${B}/feed`}>All signals →</a></div>
      <div class="signals">
        {changes.map((c) => (
          <a class="sig" href={c.slugs[0] ? `${B}/wiki/${c.slugs[0]}` : `${B}/feed`}>
            <time>{fmtDate(c.date, 'short')} · {c.hash}</time>
            <strong>{c.subject.replace(/^wiki\([^)]*\):\s*/, '')}</strong>
            <div class="chips">{c.slugs.slice(0, 4).map((s) => <span class="chip" style={`--c:${ATLAS_COLORS[bySlug.get(s)!.category]}`}><i></i>{bySlug.get(s)!.title.slice(0, 26)}</span>)}</div>
          </a>
        ))}
      </div>
    </section>
    <section class="sect">
      <div class="sect-head"><div><span class="eyebrow">Regions</span><h2>Explore by territory</h2></div></div>
      <div class="regions">{cats.map((c) => <a class="region" href={`${B}/browse/${c.id}`} style={`--c:${ATLAS_COLORS[c.id]}`}><b>{c.count}</b><h3>{c.plural}</h3><p>{c.blurb}</p></a>)}</div>
    </section>
  </main>
  <footer class="afoot"><span>Sovereign Agents Atlas · Proposal B</span><a href="/">Compare proposals →</a></footer>
</Layout>
<script>
  import { mountGraph } from '../../scripts/graph-canvas';
  import { ATLAS_COLORS } from '../../lib/colors';
  const root = document.querySelector<HTMLElement>('[data-map]')!;
  const card = root.querySelector<HTMLElement>('.card-float')!; const tip = root.querySelector<HTMLElement>('.tip')!;
  const f = (k: string) => card.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
  Promise.all([fetch('/graph.json').then((r) => r.json()), fetch('/search-index.json').then((r) => r.json())]).then(([data, idx]) => {
    const sum = new Map(idx.map((d: any) => [d.id, d]));
    const g = mountGraph(root.querySelector('canvas')!, data, {
      colors: ATLAS_COLORS,
      onHover: (n, x, y) => { if (!n) { tip.style.display = 'none'; return; } tip.textContent = n.t; tip.style.display = 'block'; tip.style.left = x + 14 + 'px'; tip.style.top = y + 10 + 'px'; },
      onSelect: (n) => {
        if (!n) { card.classList.remove('show'); return; }
        const d: any = sum.get(n.id) || {};
        f('cat').style.setProperty('--c', ATLAS_COLORS[n.c]); f('cat').querySelector('b')!.textContent = d.cl || n.c;
        f('t').textContent = n.t; f('s').textContent = (d.s || '').slice(0, 220); f('d').textContent = `${n.d} connections`;
        (f('go') as HTMLAnchorElement).href = `/proposal-b/wiki/${n.id}`; card.classList.add('show');
      },
    });
    root.querySelectorAll<HTMLButtonElement>('.legend button').forEach((b) => b.addEventListener('click', () => { b.classList.toggle('off'); g.toggle(b.dataset.cat!, !b.classList.contains('off')); }));
    root.querySelectorAll<HTMLButtonElement>('[data-z]').forEach((b) => b.addEventListener('click', () => { const z = b.dataset.z; z === 'in' ? g.zoom(1.4) : z === 'out' ? g.zoom(1 / 1.4) : g.reset(); }));
  });
</script>
