---
import Layout from '../../../layouts/JournalLayout.astro';
import { categories, byCategory } from '../../../lib/wiki';
const B = '/proposal-a';
---
<Layout title="Departments" active="browse">
  <div class="page-title"><span class="kicker">Departments</span><h1>The whole journal, by desk</h1><p>Every entry in the knowledge base, filed under the department that covers it.</p></div>
  <div class="depts">
    {categories().map((c) => (
      <section class="dept">
        <h2><a href={`${B}/browse/${c.id}`}>{c.plural}</a><small>{c.count}</small></h2>
        <p class="blurb">{c.blurb}</p>
        <ul>{byCategory(c.id).slice(0, 12).map((a) => <li><a href={`${B}/wiki/${a.slug}`}>{a.title}</a><span>{a.backlinks.length}</span></li>)}</ul>
        {c.count > 12 && <p class="meta"><a href={`${B}/browse/${c.id}`}>+ {c.count - 12} more →</a></p>}
      </section>
    ))}
  </div>
</Layout>
