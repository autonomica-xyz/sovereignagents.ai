---
import Layout from '../../../layouts/JournalLayout.astro';
import { categories, byCategory, fmtDate } from '../../../lib/wiki';
export const getStaticPaths = () => categories().map((c) => ({ params: { cat: c.id }, props: { c } }));
const { c } = Astro.props as any;
const B = '/proposal-a';
const items = byCategory(c.id);
---
<Layout title={c.plural} active="browse">
  <div class="page-title"><a class="kicker" href={`${B}/browse`}>Departments</a><h1>{c.plural}</h1><p>{c.blurb} {c.count} entries.</p></div>
  <div class="cards" style="margin-top:30px">
    {items.map((a) => (
      <article class="card">
        <span class="meta">{a.updated ? `Revised ${fmtDate(a.updated)}` : ''}{a.status ? ` · ${a.status}` : ''}</span>
        <h3><a href={`${B}/wiki/${a.slug}`}>{a.title}</a></h3>
        <p>{a.summary}</p>
        <span class="meta">cited by {a.backlinks.length} · {a.sourceCount} sources</span>
      </article>
    ))}
  </div>
</Layout>
