---
import Base from '../layouts/Base.astro';
import { theme } from '@theme/config';
---
<Base title="Not found">
  {theme.id === 'organism' && (
    <script is:inline>
      // Static hosts serve this one root 404.html for every missing path. Send old v3 preview
      // paths to their new home, and show the nerd 404 for missing pages under /nerd/.
      (function () {
        var p = location.pathname, m = p.match(/^\/([acd])(\/.*)?$/);
        if (m) { location.replace((m[1] === 'c' ? '/nerd' : '') + (m[2] || '/') + location.search + location.hash); return; }
        if (p.indexOf('/nerd/') !== 0) return;
        document.documentElement.style.visibility = 'hidden';
        fetch('/nerd/404.html').then(function (r) { if (!r.ok) throw r; return r.text(); }).then(function (html) {
          document.open(); document.write(html); document.close();
        }).catch(function () { document.documentElement.style.visibility = ''; });
      })();
    </script>
  )}
  <div class="wrap single not-found">
    <p class="kicker">404</p>
    <h1>Page not found</h1>
    <p class="lede">The page you asked for does not exist. Try <a href="/?q=" data-open-search>searching</a>, or start from the <a href="/">home page</a>.{theme.id === 'organism' && <> Looking for the terminal? Try <a href="/nerd/">nerd mode</a>.</>}</p>
  </div>
</Base>
