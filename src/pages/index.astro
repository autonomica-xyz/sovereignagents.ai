---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/fraunces';
import '@fontsource/ibm-plex-mono/400.css';
import { wiki, totals, fmtDate } from '../lib/wiki';
const { meta } = wiki();
const t = totals();
const P = [
  { id: 'a', name: 'Field Journal', tag: 'Editorial · longform', href: '/proposal-a', sample: '/proposal-a/wiki/digital-organism', feed: '/proposal-a/feed',
    line1: 'A magazine for the frontier: a masthead, dated dispatches from every research pass, and longform typography that makes 300 dense entries feel like reading.',
    line2: 'Best if the goal is authority and a following: people come back for the latest issue and share individual pieces.', bg: '#f3ede2', fg: '#1c1a17', ac: '#b4361c' },
  { id: 'b', name: 'Atlas', tag: 'Knowledge graph · anatomy', href: '/proposal-b', sample: '/proposal-b/wiki/threshold-custody', feed: '/proposal-b/feed',
    line1: 'The whole wiki as a living map: every entry a node, every citation a line, plus an organism anatomy that files each building block under the organ it keeps alive.',
    line2: 'Best for exploration and for showing how the pieces connect; the graph grows visibly as the research does.', bg: '#05070d', fg: '#e6ecff', ac: '#4fd2ff' },
  { id: 'c', name: 'Specimen Catalog', tag: 'Living dashboard', href: '/proposal-c', sample: '/proposal-c/wiki/tee-hee-he', feed: '/proposal-c/feed',
    line1: 'A field lab for digital organisms: each agent is a specimen with a sovereignty level, five-axis vital signs and a pulse; habitats and pathogens are catalogued beside them.',
    line2: 'Best for tracking the state of the art over time and comparing projects at a glance.', bg: '#e9ece4', fg: '#0f1d17', ac: '#136f48' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>sovereignagents.ai — three design proposals</title>
  <meta name="description" content="Three medium-fidelity proposals for the sovereignagents.ai knowledge base." />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23111'/><circle cx='16' cy='16' r='7' fill='none' stroke='%23fff' stroke-width='2'/></svg>" />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#0e0e0c;color:#efeee8;font-family:'Inter Tight Variable',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    .wrap{max-width:1320px;margin:0 auto;padding:56px 28px 80px}
    .eyebrow{font:400 12px 'IBM Plex Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:#9b988c}
    h1{font-family:'Fraunces Variable',serif;font-weight:500;font-size:clamp(40px,6vw,84px);line-height:.98;letter-spacing:-.035em;margin:16px 0 20px;max-width:1000px}
    h1 em{font-style:italic;font-weight:300;color:#d9d4c4}
    .lede{font-size:19px;line-height:1.55;color:#bdb9ad;max-width:760px;margin:0 0 14px}
    .facts{font:400 12.5px 'IBM Plex Mono',monospace;color:#8c897e;margin:0 0 48px}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    .p{display:flex;flex-direction:column;border-radius:18px;overflow:hidden;background:#181816;border:1px solid #2a2a26;transition:transform .25s,border-color .25s}
    .p:hover{transform:translateY(-4px);border-color:#4a4a42}
    .thumb{display:block;aspect-ratio:16/10;overflow:hidden;background:var(--bg);border-bottom:1px solid #2a2a26;position:relative}
    .thumb img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .6s}
    .p:hover .thumb img{transform:scale(1.03)}
    .letter{position:absolute;left:14px;top:12px;font:600 12px 'IBM Plex Mono',monospace;background:var(--ac);color:#fff;border-radius:6px;padding:3px 8px}
    .body{padding:22px 22px 24px;display:flex;flex-direction:column;gap:12px;flex:1}
    .body h2{font-family:'Fraunces Variable',serif;font-weight:500;font-size:34px;letter-spacing:-.025em;margin:0;line-height:1}
    .tag{font:400 11.5px 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.1em;color:var(--ac2)}
    .body p{margin:0;color:#c9c6ba;font-size:15.5px;line-height:1.55}
    .body p.l2{color:#94918686;color:#9a978b;font-size:14.5px}
    .links{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:8px}
    .links a{font:400 12.5px 'IBM Plex Mono',monospace;color:#efeee8;text-decoration:none;border:1px solid #3a3a34;border-radius:999px;padding:7px 12px}
    .links a.go{background:#efeee8;color:#111;border-color:#efeee8}
    .links a:hover{border-color:#efeee8}
    footer{margin-top:56px;padding-top:22px;border-top:1px solid #2a2a26;font:400 12.5px 'IBM Plex Mono',monospace;color:#8c897e;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
    footer a{color:#d9d4c4}
    @media (max-width:1000px){.grid{grid-template-columns:1fr;max-width:640px}}
  </style>
</head>
<body>
  <div class="wrap">
    <span class="eyebrow">sovereignagents.ai · design review · {fmtDate(meta.syncedAt)}</span>
    <h1>Three ways to show the world <em>how digital organisms survive.</em></h1>
    <p class="lede">Each proposal is a working knowledge base built from the same live research wiki: a home page, a latest-developments feed, browsing by category, article pages with backlinks and diagrams, and instant search (press <b>/</b>). Pick the direction; the content pipeline carries over unchanged.</p>
    <p class="facts">{t.pages} entries · {t.links.toLocaleString('en')} links · {t.sources} cited sources · {t.logs} research dispatches · wiki @ {meta.head}</p>
    <div class="grid">
      {P.map((p) => (
        <article class="p" style={`--bg:${p.bg};--ac:${p.ac};--ac2:${p.id === 'b' ? '#4fd2ff' : p.id === 'a' ? '#e0866b' : '#6fd19f'}`}>
          <a class="thumb" href={p.href}><img src={`/thumbs/${p.id}.webp`} alt={`${p.name} home page`} loading="eager" /><span class="letter">{p.id.toUpperCase()}</span></a>
          <div class="body">
            <span class="tag">{p.tag}</span>
            <h2>{p.name}</h2>
            <p>{p.line1}</p>
            <p class="l2">{p.line2}</p>
            <div class="links"><a class="go" href={p.href}>Open proposal {p.id.toUpperCase()} →</a><a href={p.sample}>Sample article</a><a href={p.feed}>Feed</a></div>
          </div>
        </article>
      ))}
    </div>
    <footer><span>Content: <a href={meta.repo}>autonomica-xyz/sovereign-agents-research</a> (CC-BY-4.0), pulled at build time.</span><span>Medium fidelity: real content, real navigation, partial polish.</span></footer>
  </div>
</body>
</html>
