---
import Layout from '../../layouts/CatalogLayout.astro';
import SpecCard from '../../components/SpecCard.astro';
import { allSpecimens } from '../../lib/organism';
const B = '/proposal-c';
const sp = allSpecimens() as any[];
---
<Layout title="Specimens" active="specimens">
  <div class="hd"><div><span class="lab g">Catalog · {sp.length} specimens</span><h1>Specimens</h1><p>Agents that hold or held their own money. Radar readings (privacy, custody, funding, continuity, independence) are derived from the comparison matrix columns: none, partial or strong.</p></div></div>
  <div class="filters" data-filters>
    <div class="grp"><span class="lab" style="padding:5px 6px">Status</span><button class="on" data-f="alive" data-v="all">All</button><button data-f="alive" data-v="active">Active</button><button data-f="alive" data-v="dormant">Dormant</button><button data-f="alive" data-v="frozen">Frozen</button></div>
    <div class="grp"><span class="lab" style="padding:5px 6px">Level ≥</span><button class="on" data-f="level" data-v="-1">Any</button><button data-f="level" data-v="1">L1</button><button data-f="level" data-v="2">L2</button><button data-f="level" data-v="3">L3</button></div>
    <span class="lab" data-count></span>
  </div>
  <div class="specs" data-specs>{sp.map((s) => <SpecCard s={s} base={B} />)}</div>
</Layout>
<script>
  const st = { alive: 'all', level: '-1' } as Record<string, string>;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-specs] .spec')];
  const count = document.querySelector('[data-count]')!;
  function apply() { let n = 0; for (const c of cards) { const ok = (st.alive === 'all' || c.dataset.alive === st.alive) && Number(c.dataset.level) >= Number(st.level); c.style.display = ok ? '' : 'none'; n += +ok; } count.textContent = `${n} shown`; }
  document.querySelectorAll<HTMLButtonElement>('[data-filters] button').forEach((b) => b.addEventListener('click', () => { st[b.dataset.f!] = b.dataset.v!; b.parentElement!.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b)); apply(); }));
  apply();
</script>
