---
import Layout from '../../../layouts/CatalogLayout.astro';
import Vitals from '../../../components/Vitals.astro';
import { wiki, fmtDate, withBase, catLabel, CATEGORY_ORDER } from '../../../lib/wiki';
import { allSpecimens, organs } from '../../../lib/organism';
export const getStaticPaths = () => wiki().articles.map((a) => ({ params: { slug: a.slug }, props: { a } }));
const { a } = Astro.props as any;
const B = '/proposal-c';
const { bySlug, articles } = wiki();
const spec = (allSpecimens() as any[]).find((s) => s.slug === a.slug);
const sameCat = articles.filter((x) => x.category === a.category);
const code = `${(a.category || 'x').slice(0, 3).toUpperCase()}-${String(sameCat.findIndex((x) => x.slug === a.slug) + 1).padStart(3, '0')}`;
const backs = a.backlinks.map((s: string) => bySlug.get(s)!).sort((x: any, y: any) => y.backlinks.length - x.backlinks.length);
const outs = a.links.map((s: string) => bySlug.get(s)!);
const myOrgans = organs().filter((o) => o.pages.some((p) => p.slug === a.slug));
const active = a.category === 'compute' ? 'habitats' : a.category === 'attack' ? 'pathogens' : a.category === 'organism' ? 'specimens' : 'browse';
---
<Layout title={a.title} description={a.summary} active={active}>
  <div class="sheet">
    <div>
      <header class="sheet-h" data-code={spec?.code || code}>
        <a class={`cls ${a.category}`} href={`${B}/browse/${a.category}`}>{catLabel(a.category)}</a>
        <h1>{a.title}</h1>
        {a.summary && <p class="sum">{a.summary}</p>}
      </header>
      <article class="prose" set:html={withBase(a.html, B)} />
      {backs.length > 0 && (
        <section style="margin-top:16px">
          <div class="hd" style="margin-bottom:10px"><div><span class="lab">Referenced in {backs.length} entries</span></div></div>
          <div class="cards3">{backs.slice(0, 9).map((b: any) => <a class="mini" href={`${B}/wiki/${b.slug}`}><span class={`cls ${b.category}`} style="align-self:start">{catLabel(b.category)}</span><h4>{b.title}</h4><p>{b.summary}</p></a>)}</div>
        </section>
      )}
    </div>
    <aside class="side">
      {spec && (
        <div class="panel">
          <h2>Vital signs <span class={`lvbadge ${spec.levelNum >= 0 ? 'l' + spec.levelNum : 'none'}`}>{spec.level === '—' ? 'unscored' : spec.level}</span></h2>
          <span class={`status ${spec.alive}`}><i></i>{spec.status}</span>
          <div style="display:flex;justify-content:center;margin:8px 0"><Vitals readings={spec.readings} alive={spec.alive} size={190} uid={a.slug} /></div>
          <dl class="facts"><dt>Keys held by</dt><dd>{spec.keys}</dd><dt>Pays compute</dt><dd>{spec.paysCompute}</dd><dt>Replicates</dt><dd>{spec.replicates}</dd><dt>Host</dt><dd>{spec.host}</dd></dl>
        </div>
      )}
      <div class="panel">
        <h2>Specimen data</h2>
        <dl class="facts">
          <dt>Class</dt><dd>{catLabel(a.category)}</dd>
          {a.status && <><dt>Status</dt><dd>{a.status}</dd></>}
          {a.updated && <><dt>Observed</dt><dd>{fmtDate(a.updated)}</dd></>}
          <dt>Length</dt><dd>{a.words.toLocaleString('en')} words</dd>
          <dt>Sources</dt><dd>{a.sourceCount}</dd>
          <dt>Links</dt><dd>{a.links.length} out · {a.backlinks.length} in</dd>
          {myOrgans.length > 0 && <><dt>Organ</dt><dd>{myOrgans.map((o) => o.name).join(', ')}</dd></>}
          <dt>File</dt><dd><a href={`https://github.com/autonomica-xyz/sovereign-agents-research/blob/main/${a.path}`} style="font-family:var(--mono);font-size:11px">{a.path}</a></dd>
        </dl>
      </div>
      {outs.length > 0 && <div class="panel"><h2>Cites <span class="lab">{outs.length}</span></h2><ul class="reflist">{outs.map((o: any) => <li><a href={`${B}/wiki/${o.slug}`}>{o.title}<span class={`cls ${o.category}`}>{catLabel(o.category)}</span></a></li>)}</ul></div>}
      {backs.length > 9 && <div class="panel"><h2>Also referenced in <span class="lab">{backs.length - 9}</span></h2><ul class="reflist">{backs.slice(9).map((o: any) => <li><a href={`${B}/wiki/${o.slug}`}>{o.title}<span class={`cls ${o.category}`}>{catLabel(o.category)}</span></a></li>)}</ul></div>}
    </aside>
  </div>
</Layout>
