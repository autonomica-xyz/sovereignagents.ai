---
import Layout from '../../../layouts/CatalogLayout.astro';
import IndexTable from '../../../components/IndexTable.astro';
import { categories, byCategory } from '../../../lib/wiki';
export const getStaticPaths = () => categories().map((c) => ({ params: { cat: c.id }, props: { c } }));
const { c } = Astro.props as any;
const B = '/proposal-c';
const items = byCategory(c.id).sort((a, b) => b.backlinks.length - a.backlinks.length);
const names: Record<string, string> = { compute: 'Habitats', attack: 'Pathogens', organism: 'Organisms (entries)' };
const active = c.id === 'compute' ? 'habitats' : c.id === 'attack' ? 'pathogens' : 'browse';
---
<Layout title={names[c.id] || c.plural} active={active}>
  <div class="hd"><div><a class="lab g" href={`${B}/browse`} style="text-decoration:none">Full index / {c.plural}</a><h1>{names[c.id] || c.plural}</h1><p>{c.blurb} {c.count} entries, sorted by how often the rest of the wiki cites them.</p></div></div>
  <IndexTable items={items} base={B} showCat={false} />
</Layout>
