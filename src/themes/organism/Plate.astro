---
// A specimen plate: a radiolarian-like form generated from a system's five axis scores and level.
import { closed, polar, deg, f, type P } from './geom';
import { AXES } from '../../lib/site';
interface Props { specimen: any; size?: number; detail?: boolean }
const { specimen, size = 200, detail = false } = Astro.props;
const d = specimen.data;
const c = 100;
const sc = AXES.map((a) => d.ratings[a].score);
const ang = (i: number) => deg(-90 + i * 72);
const body: P[] = [];
AXES.forEach((_, i) => { body.push(polar(c, c, 20 + sc[i] * 9, ang(i))); body.push(polar(c, c, 16 + (sc[i] + sc[(i + 1) % 5]) * 3.2, ang(i) + deg(36))); });
const spines = sc.map((s, i) => ({ a: polar(c, c, 18 + s * 9, ang(i)), b: polar(c, c, 40 + s * 17, ang(i)), s }));
const rings = Array.from({ length: d.level + 1 }, (_, k) => 9 + k * 5.5);
const seed = specimen.id.length;
const hair = Array.from({ length: 36 }, (_, i) => { const t = deg(i * 10 + seed); const r = 16 + sc[Math.floor(((i * 10) % 360) / 72)] * 6; const a = polar(c, c, r, t), b = polar(c, c, r + 5 + (i % 3), t); return `M${f(a[0])},${f(a[1])}L${f(b[0])},${f(b[1])}`; }).join('');
const glow = 0.25 + (sc.reduce((x, y) => x + y, 0) / 15) * 0.75;
---
<svg class:list={["plate-svg", detail && "detail"]} viewBox="0 0 200 200" width={size} height={size} role="img" aria-label={`${d.name}: form generated from its scores (${AXES.map((a, i) => `${a} ${sc[i]}`).join(', ')}) and level L${d.level}`} style={`--g:${glow}`}>
  <circle cx={c} cy={c} r="96" class="pl-field" />
  {detail && AXES.map((a, i) => { const [x, y] = polar(c, c, 93, ang(i)); return <text x={x} y={y} class="pl-ax" text-anchor="middle" dominant-baseline="middle">{a.slice(0, 3)}</text>; })}
  <g class="pl-spin">
    <path d={hair} class="pl-hair" />
    {spines.map((s) => <g><line x1={f(s.a[0])} y1={f(s.a[1])} x2={f(s.b[0])} y2={f(s.b[1])} class="pl-spine" /><circle cx={f(s.b[0])} cy={f(s.b[1])} r={1.6 + s.s * 1.3} class="pl-bulb" /></g>)}
    <path d={closed(body)} class="pl-body" />
    {rings.map((r) => <circle cx={c} cy={c} r={r} class="pl-ring" />)}
    <circle cx={c} cy={c} r="4.5" class="pl-core" />
  </g>
</svg>
