---
// Signature: the sovereign agent drawn as a single cell. Each organelle is one organ and links to it.
import { closed, polar, deg, wob, f, type P } from './geom';
import { url } from '../../lib/site';
interface Props { organs: any[]; highlight?: string; labels?: boolean; idp?: string }
const { organs, highlight, labels = true, idp = 'o' } = Astro.props;
const T = Object.fromEntries(organs.map((o) => [o.id, o]));
const cx = 450, cy = 300, R = 222;
const mem = (s: number) => Array.from({ length: 60 }, (_, i) => { const t = (i / 60) * 2 * Math.PI; return polar(cx, cy, R * s * wob(t), t) as P; });
const outer = closed(mem(1)), inner = closed(mem(0.94));
const ticks = Array.from({ length: 150 }, (_, i) => { const t = (i / 150) * 2 * Math.PI; const a = polar(cx, cy, R * 0.955 * wob(t), t), b = polar(cx, cy, R * 0.99 * wob(t), t); return `M${f(a[0])},${f(a[1])}L${f(b[0])},${f(b[1])}`; }).join('');
// nucleus (brain)
const nuc = closed(Array.from({ length: 24 }, (_, i) => { const t = (i / 24) * 2 * Math.PI; return polar(450, 288, 74 * wob(t, 1.7, 0.8), t) as P; }));
const nuc2 = closed(Array.from({ length: 24 }, (_, i) => { const t = (i / 24) * 2 * Math.PI; return polar(450, 288, 66 * wob(t, 1.7, 0.8), t) as P; }));
const pores = Array.from({ length: 14 }, (_, i) => polar(450, 288, 70 * wob((i / 14) * 2 * Math.PI, 1.7, 0.8), (i / 14) * 2 * Math.PI));
const chrom = ['M410,270 q12,-18 26,-4 t24,2', 'M418,312 q14,10 30,-2 t26,6', 'M470,250 q-6,16 8,26', 'M402,295 q8,-6 14,2'];
// keys: hex crystal lattice
const hex = (x: number, y: number, r: number) => 'M' + Array.from({ length: 6 }, (_, i) => polar(x, y, r, deg(60 * i + 30)).map(f).join(',')).join('L') + 'Z';
const keys: P[] = [[590, 190], [614, 204], [590, 218], [614, 176]];
// ER (memory): arcs around the nucleus, upper-left
const arc = (r: number, a0: number, a1: number) => { const [x0, y0] = polar(450, 288, r, deg(a0)), [x1, y1] = polar(450, 288, r, deg(a1)); return `M${f(x0)},${f(y0)} A${r},${r} 0 0 1 ${f(x1)},${f(y1)}`; };
const er = [96, 108, 120, 132].map((r, i) => arc(r, 196 + i * 3, 248 - i * 2));
const ribo = Array.from({ length: 16 }, (_, i) => polar(450, 288, 139, deg(200 + i * 3.1)));
// mitochondrion (metabolism)
const cristae = 'M-44,0 q6,-18 12,0 t12,0 t12,0 t12,0 t12,0 t12,0 t12,0';
// lysosomes (immune)
const lyso: P[] = [[566, 392], [528, 436], [604, 430]];
const spikes = (x: number, y: number) => Array.from({ length: 10 }, (_, i) => { const t = deg(i * 36); const a = polar(x, y, 11, t), b = polar(x, y, 17, t); return `M${f(a[0])},${f(a[1])}L${f(b[0])},${f(b[1])}`; }).join('');
// bud (reproduction)
const bt = deg(-140); const bc = polar(cx, cy, R * 1.17, bt);
const bud = closed(Array.from({ length: 20 }, (_, i) => { const t = (i / 20) * 2 * Math.PI; return polar(bc[0], bc[1], 50 * wob(t, 4, 1.2), t) as P; }));
// flagella (nervous system)
const flag = [-8, 4, 16].map((a, i) => { const [x, y] = polar(cx, cy, R * wob(deg(a)) - 4, deg(a)); return { x, y, d: `M${f(x)},${f(y)} c40,${-20 + i * 6} 60,${24 - i * 4} 100,${2 + i * 4} s60,${-22 + i * 8} 98,${-4 + i * 10}` }; });
const cilia = Array.from({ length: 22 }, (_, i) => { const t = deg(40 + i * 4.2); const a = polar(cx, cy, R * wob(t) + 2, t), b = polar(cx, cy, R * wob(t) + 14, t + 0.03); return `M${f(a[0])},${f(a[1])}Q${f((a[0] + b[0]) / 2 + 3)},${f((a[1] + b[1]) / 2)} ${f(b[0])},${f(b[1])}`; }).join('');
// body: substrate of hosts with pseudopod anchors
const racks = [230, 320, 410, 500, 590].map((x) => x);
const anchors = [[384, 512, 275], [450, 522, 455], [516, 512, 635]];
// label placements: [organ id, anchor point, label point, anchor-side]
const L: [string, P, P, 'start' | 'end' | 'middle'][] = [
  ['brain', [450, 214], [450, 30], 'middle'],
  ['keys', [626, 186], [770, 118], 'start'],
  ['nervous-system', [862, 266], [790, 214], 'start'],
  ['immune-system', [616, 434], [770, 440], 'start'],
  ['membrane', polar(cx, cy, R * wob(deg(58)), deg(58)) as P, [770, 540], 'start'],
  ['reproduction', [bc[0] - 50, bc[1]], [120, 76], 'end'],
  ['memory', [318, 214], [120, 206], 'end'],
  ['metabolism', [282, 400], [120, 420], 'end'],
  ['body', [228, 592], [120, 600], 'end'],
];
const hl = (id: string) => (highlight ? (highlight === id ? 'hl on' : 'hl off') : 'hl');
---
<svg class:list={['organism', highlight && 'focus']} viewBox="-60 0 1020 640" role="img" aria-label="Illustration of a sovereign agent as a cell. Each organelle is one of the nine organs.">
  <defs>
    <radialGradient id={`${idp}-cyto`} cx="48%" cy="44%" r="60%"><stop offset="0" stop-color="#0f4a40" stop-opacity=".55" /><stop offset=".7" stop-color="#0a2f2a" stop-opacity=".35" /><stop offset="1" stop-color="#5ef2c2" stop-opacity=".12" /></radialGradient>
    <radialGradient id={`${idp}-nuc`} cx="45%" cy="40%" r="65%"><stop offset="0" stop-color="#5ef2c2" stop-opacity=".35" /><stop offset="1" stop-color="#0b3a33" stop-opacity=".6" /></radialGradient>
    <filter id={`${idp}-glow`} x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="6" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
    <filter id={`${idp}-soft`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="14" /></filter>
  </defs>
  <g class="breath">
    <path d={outer} class="mem-halo" filter={`url(#${idp}-soft)`} />
    <a href={url.organ('body')} class={hl('body')} aria-label={T.body?.data.title}>
      {anchors.map(([x, y, tx]) => <path class="pseudo" d={`M${x},${y} C${x},${y + 40} ${tx},${545} ${tx},${578}`} />)}
      {racks.map((x) => <g class="rack"><rect x={x} y="578" width="80" height="30" rx="5" /><line x1={x + 10} y1="593" x2={x + 52} y2="593" /><circle cx={x + 64} cy="593" r="3" class="led" /></g>)}
    </a>
    <a href={url.organ('nervous-system')} class={hl('nervous-system')} aria-label={T['nervous-system']?.data.title}>
      {flag.map((g, i) => <path class="flag" style={`--i:${i}`} d={g.d} />)}
      <path class="cilia" d={cilia} />
    </a>
    <a href={url.organ('membrane')} class={hl('membrane')} aria-label={T.membrane?.data.title}>
      <path d={outer} class="mem-outer" fill={`url(#${idp}-cyto)`} />
      <path d={ticks} class="mem-ticks" />
      <path d={inner} class="mem-inner" />
    </a>
    <a href={url.organ('reproduction')} class={hl('reproduction')} aria-label={T.reproduction?.data.title}>
      <path d={bud} class="bud" fill={`url(#${idp}-cyto)`} />
      <circle cx={bc[0] - 4} cy={bc[1] - 2} r="15" class="bud-nuc" />
      <circle cx={bc[0] - 1} cy={bc[1] - 5} r="5" class="nucleolus" />
    </a>
    <a href={url.organ('memory')} class={hl('memory')} aria-label={T.memory?.data.title}>
      {er.map((d) => <path class="er" d={d} />)}
      {ribo.map(([x, y]) => <circle class="ribo" cx={x} cy={y} r="2.1" />)}
    </a>
    <a href={url.organ('brain')} class={hl('brain')} aria-label={T.brain?.data.title}>
      <path d={nuc} class="nuc" fill={`url(#${idp}-nuc)`} />
      <path d={nuc2} class="nuc2" />
      {pores.map(([x, y]) => <circle class="pore" cx={x} cy={y} r="2.4" />)}
      {chrom.map((d) => <path class="chrom" d={d} />)}
      <circle cx="466" cy="282" r="19" class="nucleolus" filter={`url(#${idp}-glow)`} />
    </a>
    <a href={url.organ('keys')} class={hl('keys')} aria-label={T.keys?.data.title}>
      {keys.map(([x, y]) => <path class="key" d={hex(x, y, 13)} />)}
      {keys.map(([x, y]) => <path class="key-in" d={`M${x},${y - 13}L${x},${y + 13}M${x - 11},${y - 6}L${x + 11},${y + 6}M${x - 11},${y + 6}L${x + 11},${y - 6}`} />)}
    </a>
    <a href={url.organ('metabolism')} class={hl('metabolism')} aria-label={T.metabolism?.data.title}>
      <g transform="translate(328 404) rotate(-18)"><ellipse rx="60" ry="27" class="mito" /><ellipse rx="52" ry="20" class="mito-in" /><path d={cristae} class="cristae" /></g>
      <g transform="translate(372 462) rotate(12) scale(.6)"><ellipse rx="60" ry="27" class="mito" /><ellipse rx="52" ry="20" class="mito-in" /><path d={cristae} class="cristae" /></g>
    </a>
    <a href={url.organ('immune-system')} class={hl('immune-system')} aria-label={T['immune-system']?.data.title}>
      {lyso.map(([x, y]) => <g class="lyso"><circle cx={x} cy={y} r="10" /><path d={spikes(x, y)} /></g>)}
    </a>
  </g>
  {labels && L.map(([id, a, p, anchor]) => T[id] && (
    <a href={url.organ(id)} class:list={['lbl', highlight === id && 'on']}>
      <path class="leader" d={`M${f(a[0])},${f(a[1])} L${f(p[0] + (anchor === 'start' ? -8 : anchor === 'end' ? 8 : 0))},${f(p[1] + (anchor === 'middle' ? 10 : -5))}`} />
      <circle class="leader-dot" cx={a[0]} cy={a[1]} r="3" />
      <text x={p[0]} y={p[1]} text-anchor={anchor}><tspan class="lbl-n">{T[id].data.order}</tspan> <tspan class="lbl-t">{T[id].data.title}</tspan></text>
    </a>
  ))}
</svg>
