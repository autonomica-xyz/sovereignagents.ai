---
// Five-axis radar. Values are 0–3 per axis in AXES order.
import { AXES, AXIS_LABEL } from '../../lib/site';
interface Series { values: number[]; label?: string; strong?: boolean }
interface Props { series: Series[]; size?: number; labels?: boolean; id: string; class?: string }
const { series, size = 320, labels = true, id, class: cls } = Astro.props;
const pad = labels ? 64 : 8;
const c = size / 2, r = c - pad;
const ang = (i: number) => -Math.PI / 2 + (i * 2 * Math.PI) / AXES.length;
const pt = (i: number, v: number) => [c + Math.cos(ang(i)) * r * (v / 3), c + Math.sin(ang(i)) * r * (v / 3)];
const poly = (vals: number[]) => vals.map((v, i) => pt(i, Math.max(v, 0.08)).map((n) => n.toFixed(1)).join(',')).join(' ');
---
<svg class:list={['radar', cls]} viewBox={`0 0 ${size} ${size}`} role="img" aria-label={series.map((s) => `${s.label ?? ''} ${AXES.map((a, i) => `${AXIS_LABEL[a]} ${s.values[i]} of 3`).join(', ')}`).join('; ')}>
  <defs>
    <radialGradient id={`${id}-fill`} cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#8b9cff" stop-opacity=".05" /><stop offset="1" stop-color="#8b9cff" stop-opacity=".32" /></radialGradient>
    <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="4" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
  </defs>
  {[1, 2, 3].map((k) => <polygon class="radar-ring" points={poly(AXES.map(() => k))} />)}
  {AXES.map((_, i) => { const [x, y] = pt(i, 3); return <line class="radar-spoke" x1={c} y1={c} x2={x} y2={y} />; })}
  {series.filter((s) => !s.strong).map((s) => <polygon class="radar-faint" points={poly(s.values)} />)}
  {series.filter((s) => s.strong).map((s) => <g filter={`url(#${id}-glow)`}><polygon class="radar-area" fill={`url(#${id}-fill)`} points={poly(s.values)} />{s.values.map((v, i) => { const [x, y] = pt(i, Math.max(v, 0.08)); return <circle class="radar-dot" cx={x} cy={y} r="3.2" />; })}</g>)}
  {labels && AXES.map((a, i) => { const [x, y] = pt(i, 3.62); return <text class="radar-label" x={x} y={y} text-anchor={Math.abs(x - c) < 4 ? 'middle' : x > c ? 'start' : 'end'} dominant-baseline="middle">{AXIS_LABEL[a]}</text>; })}
</svg>
