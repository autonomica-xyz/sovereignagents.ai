---
// Signature: the sovereignty staircase, with every tracked system placed on its step.
import { LEVELS, url } from '../../lib/site';
const { specimens } = Astro.props;
const top = Math.max(...specimens.map((s: any) => s.data.level));
---
<div class="ladder-a" role="figure" aria-label={`Sovereignty levels L0 to L5. Highest observed: L${top}.`}>
  {LEVELS.map((l) => {
    const here = specimens.filter((s: any) => s.data.level === l.n);
    return (
      <div class:list={['step', l.n <= top ? 'reached' : 'unreached', l.n === top && 'frontier']} style={`--i:${l.n};--h:${[24, 50, 62, 74, 87, 100][l.n]}%`}>
        <div class="step-col">
          <div class="step-bar">
            {here.length > 0 ? <ul>{here.map((s: any) => <li><a href={url.specimen(s.id)}>{s.data.name}</a></li>)}</ul> : <span class="step-empty">{l.n > top ? 'Not observed' : 'None tracked'}</span>}
          </div>
        </div>
        <div class="step-meta"><b>L{l.n}</b><span>{l.name}</span><small>{here.length || '–'}</small></div>
      </div>
    );
  })}
  <div class="frontier-tag" style={`--i:${top}`}><span>Frontier · Nov 2026</span></div>
</div>
