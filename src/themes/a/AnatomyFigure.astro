---
// Signature: a radial map linking the nine organs (outer ring) to the five axes they serve (inner ring).
import { AXES, AXIS_LABEL, url } from '../../lib/site';
const { organs } = Astro.props;
const W = 760, H = 560, cx = W / 2, cy = H / 2, R = 215, r = 92;
const op = organs.map((o: any, i: number) => { const t = -Math.PI / 2 + (i * 2 * Math.PI) / organs.length; return { o, x: cx + Math.cos(t) * R, y: cy + Math.sin(t) * R, t }; });
const counts = AXES.map((a) => organs.filter((o: any) => o.data.axes.includes(a)).length);
const most = AXES[counts.indexOf(Math.max(...counts))];
const all5 = organs.filter((o: any) => o.data.axes.length === AXES.length).map((o: any) => o.data.title);
const ap = AXES.map((a, i) => { const t = -Math.PI / 2 + (i * 2 * Math.PI) / AXES.length; return { a, x: cx + Math.cos(t) * r, y: cy + Math.sin(t) * r }; });
---
<section class="a-anat">
  <svg viewBox={`-70 0 ${W + 140} ${H}`} role="img" aria-label="Map of the nine organs and the five axes each one serves">
    <defs>
      <radialGradient id="anat-core"><stop offset="0" stop-color="#8b9cff" stop-opacity=".25" /><stop offset="1" stop-color="#8b9cff" stop-opacity="0" /></radialGradient>
      <linearGradient id="anat-edge" x1="0" x2="1"><stop offset="0" stop-color="#8b9cff" stop-opacity=".1" /><stop offset="1" stop-color="#c3cbff" stop-opacity=".55" /></linearGradient>
    </defs>
    <circle cx={cx} cy={cy} r={r + 60} fill="url(#anat-core)" />
    <circle class="anat-orbit" cx={cx} cy={cy} r={R} />
    <circle class="anat-orbit" cx={cx} cy={cy} r={r} />
    {op.map((p: any) => p.o.data.axes.map((a: string) => { const q = ap.find((x) => x.a === a)!; return <path class="anat-edge" data-o={p.o.id} d={`M${p.x.toFixed(1)},${p.y.toFixed(1)} Q${cx},${cy} ${q.x.toFixed(1)},${q.y.toFixed(1)}`} />; }))}
    {ap.map((q) => <g class="anat-axis"><circle cx={q.x} cy={q.y} r="5" /><text x={q.x} y={q.y + (q.y > cy ? 22 : -14)} text-anchor="middle">{AXIS_LABEL[q.a]}</text></g>)}
    {op.map((p: any) => (
      <a href={url.organ(p.o.id)} class="anat-node" data-o={p.o.id}>
        <circle cx={p.x} cy={p.y} r="9" />
        <text x={p.x + Math.cos(p.t) * 22} y={p.y + Math.sin(p.t) * 22} text-anchor={Math.abs(Math.cos(p.t)) < .3 ? 'middle' : Math.cos(p.t) > 0 ? 'start' : 'end'} dominant-baseline="middle">{String(p.o.data.order).padStart(2, '0')} {p.o.data.title}</text>
      </a>
    ))}
  </svg>
  <p class="a-fig-cap">Each organ connects to the axes it serves.{all5.length > 0 && ` ${all5.join(', ')} touches all five.`} {AXIS_LABEL[most]} is served by the most organs ({Math.max(...counts)}).</p>
</section>
