---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import './theme.css';
interface Props { section?: string; crumbs: { href?: string; label: string }[] }
const { section, crumbs } = Astro.props;
const nav = [
  { id: 'blueprint', href: '/blueprint/', label: 'Blueprint' },
  { id: 'ecosystem', href: '/ecosystem/', label: 'Ecosystem' },
  { id: 'technology', href: '/technology/', label: 'Technology' },
  { id: 'about', href: '/about/', label: 'About' },
];
// Theme switch links keep the reader on the same page in the other edition.
const here = Astro.url.pathname.replace(/^\/[acd](?=\/)/, '');
const rel = /404/.test(here) ? '/' : here;
---
<div class="a-bg" aria-hidden="true"></div>
<header class="mast">
  <div class="wrap mast-in">
    <a class="brand" href="/" aria-label="Sovereign Agents, home">
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 19h4.5v-4.5H12V10h4.5V5.5H21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Sovereign Agents</span>
    </a>
    <nav class="nav" aria-label="Main">{nav.map((n) => <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>)}</nav>
    <button class="search-btn" type="button" data-open-search aria-label="Search (press /)"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span>Search</span><kbd>⌘K</kbd></button>
  </div>
</header>
{crumbs.length > 0 && <nav class="wrap crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol></nav>}
<main id="main"><slot /></main>
<footer class="foot">
  <div class="wrap foot-in">
    <div>
      <p class="foot-brand"><svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 19h4.5v-4.5H12V10h4.5V5.5H21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>Sovereign Agents</p>
      <p class="muted">A reference on software that keeps itself alive. Every claim is sourced and dated. See the <a href="/ecosystem/methodology/">methodology</a>.</p>
      <p class="theme-switch">Theme <a href={`/a${rel}`} aria-current="true">Instrument</a><a href={`/c${rel}`}>Terminal</a><a href={`/d${rel}`}>Organism</a><a data-abs href="/">All</a></p>
    </div>
    <ul class="foot-links"><li class="h">Read</li><li><a href="/blueprint/">Blueprint</a></li><li><a href="/ecosystem/">Ecosystem</a></li><li><a href="/technology/">Technology</a></li><li><a href="/ecosystem/developments/">Developments</a></li></ul>
    <ul class="foot-links"><li class="h">About</li><li><a href="/about/">About</a></li><li><a href="/ecosystem/methodology/">Methodology</a></li><li><a href="https://github.com/autonomica-xyz/sovereignagents.ai">Source</a></li><li><a href="https://github.com/autonomica-xyz/sovereign-agents-research">Research notebook</a></li></ul>
  </div>
</footer>
