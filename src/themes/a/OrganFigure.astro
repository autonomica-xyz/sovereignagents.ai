---
import { AXES, AXIS_LABEL, MATURITY } from '../../lib/site';
const { organ } = Astro.props;
const d = organ.data;
const best = d.options.reduce((a: any, b: any) => (MATURITY.indexOf(b.maturity) > MATURITY.indexOf(a.maturity) ? b : a));
---
<div class="a-organ-fig">
  <div class="a-axes">{AXES.map((a) => <span class:list={['a-axis', d.axes.includes(a) && 'on']}>{AXIS_LABEL[a]}</span>)}</div>
  <div class="a-mini"><span class="a-mini-k">Options</span><b>{d.options.length}</b></div>
  <div class="a-mini"><span class="a-mini-k">Most mature</span><b>{best.maturity}</b></div>
</div>
