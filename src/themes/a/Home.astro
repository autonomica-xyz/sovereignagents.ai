---
import Ladder from './Ladder.astro';
import Radar from './Radar.astro';
import { url, fmtDate, KIND_LABEL, AXES, AXIS_LABEL, MATURITY, MATURITY_LABEL, total } from '../../lib/site';
const { organs, technologies, specimens, developments } = Astro.props;
const top = Math.max(...specimens.map((s: any) => s.data.level));
const best = AXES.map((a) => Math.max(...specimens.map((s: any) => s.data.ratings[a].score)));
const leader = (a: string) => specimens.filter((s: any) => s.data.ratings[a].score === Math.max(...specimens.map((x: any) => x.data.ratings[a].score))).map((s: any) => s.data.name);
---
<section class="a-hero">
  <div class="wrap">
    <a class="a-pill" href="/ecosystem/developments/"><span class="a-dot"></span>Latest: {developments[0].data.title}<span aria-hidden="true">→</span></a>
    <h1 class="a-h1">Software that<br />keeps itself alive.</h1>
    <p class="a-lede">A sovereign agent holds its own keys, pays for its own compute, and runs where no single party can read or stop it. This is the reference: what such an organism needs, who has tried to build one, and which technologies can supply it today.</p>
    <div class="a-cta"><a class="btn btn-primary" href="/blueprint/">Read the blueprint</a><a class="btn" href="/ecosystem/tracker/">Open the tracker</a></div>
  </div>
</section>

<section class="wrap a-panel-wrap">
  <div class="a-panel">
    <div class="a-panel-head">
      <div><p class="a-eyebrow">The sovereignty ladder</p><h2>No tracked system has reached L3.</h2></div>
      <p class="muted">Each step removes one party who could read, stop, steer or seize the agent. L3 can be assembled from parts that ship today. Nobody has done it yet.</p>
    </div>
    <Ladder specimens={specimens} />
  </div>
  <div class="a-stats">
    <div><b>L{top}</b><span>Highest level observed</span></div>
    <div><b>{specimens.length}</b><span>Systems assessed</span></div>
    <div><b>{organs.length}</b><span>Organs mapped</span></div>
    <div><b>{technologies.length}</b><span>Technologies rated</span></div>
  </div>
</section>

<section class="wrap a-bento">
  <a class="a-card a-card-lg" href="/blueprint/">
    <p class="a-eyebrow">Blueprint</p>
    <h3>What an organism needs</h3>
    <p>Nine organs, each with its threat, the best current options and the part nobody has solved. Six levels, five axes, one build path.</p>
    <div class="a-organ-dots" aria-hidden="true">{organs.map((o: any) => <span><i></i>{o.data.title}</span>)}</div>
  </a>
  <a class="a-card" href="/ecosystem/">
    <p class="a-eyebrow">Ecosystem</p>
    <h3>Who has tried</h3>
    <p>{specimens.length} systems scored with evidence, plus a dated log of what changed.</p>
    <div class="a-spark" aria-hidden="true">{specimens.map((s: any) => <i style={`--v:${total(s.data.ratings) / 15}`}></i>)}</div>
  </a>
  <a class="a-card" href="/technology/">
    <p class="a-eyebrow">Technology</p>
    <h3>What is available</h3>
    <p>Explainers with maturity ratings and failure modes.</p>
    <ul class="a-mat" aria-hidden="true">{technologies.slice(0, 5).map((t: any) => <li><span>{t.data.title.split(' (')[0].split(' and ')[0]}</span><i style={`--m:${(MATURITY.indexOf(t.data.maturity) + 1) / 4}`}></i></li>)}</ul>
  </a>
</section>

<section class="wrap a-split">
  <div>
    <p class="a-eyebrow">Five axes</p>
    <h2>The best of the field, combined, is still not an organism.</h2>
    <p class="muted">The outline shows the highest score any tracked system reaches on each axis; the faint lines are the individual systems. No single system has all of these at once.</p>
    <ul class="a-axis-list">{AXES.map((a, i) => <li><span>{AXIS_LABEL[a]}</span><b>{best[i]}/3</b><small>{leader(a).slice(0, 2).join(', ')}{leader(a).length > 2 ? ` +${leader(a).length - 2}` : ''}</small></li>)}</ul>
  </div>
  <div class="a-radar-box"><Radar id="home-radar" size={420} series={[...specimens.map((s: any) => ({ values: AXES.map((a) => s.data.ratings[a].score), label: s.data.name })), { values: best, label: 'Best per axis', strong: true }]} /></div>
</section>

<section class="wrap a-devs">
  <div class="a-sec-head"><div><p class="a-eyebrow">Developments</p><h2>What changed recently</h2></div><a href="/ecosystem/developments/">All {developments.length} →</a></div>
  <ol class="a-timeline">
    {developments.slice(0, 6).map((d: any) => <li><time datetime={d.data.date}>{fmtDate(d.data.date)}</time><span class="tag" data-k={d.data.kind}>{KIND_LABEL[d.data.kind]}</span><a href={`/ecosystem/developments/#${d.id}`}>{d.data.title}</a></li>)}
  </ol>
</section>
