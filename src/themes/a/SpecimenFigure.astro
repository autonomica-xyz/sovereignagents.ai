---
import Radar from './Radar.astro';
import { AXES, AXIS_LABEL, SCORE_LABEL, total } from '../../lib/site';
const { specimen } = Astro.props;
const d = specimen.data;
---
<div class="a-spec-fig">
  <Radar id="spec" size={340} series={[{ values: AXES.map((a) => d.ratings[a].score), label: d.name, strong: true }]} />
  <div class="a-spec-nums">
    <div class="a-big"><b>L{d.level}</b><span>Sovereignty level</span></div>
    <div class="a-big"><b>{total(d.ratings)}<small>/15</small></b><span>Axis total</span></div>
    <ul>{AXES.map((a) => <li><span>{AXIS_LABEL[a]}</span><i style={`--v:${d.ratings[a].score / 3}`}></i><b>{SCORE_LABEL[d.ratings[a].score]}</b></li>)}</ul>
  </div>
</div>
